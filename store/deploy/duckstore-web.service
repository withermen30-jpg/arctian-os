[Unit]
Description=DuckStore Admin Web (port 129)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duckstore
Group=duckstore
WorkingDirectory=/opt/duckstore/web
Environment=DUCKSTORE_BASE=/opt/duckstore
Environment=DUCKSTORE_WEB_PORT=129
Environment=DUCKSTORE_WEB_BIND=0.0.0.0
Environment=DUCKSTORE_SIGN_KEY=/opt/duckstore/keys/dev_rsa2048.txt
ExecStart=/usr/bin/python3 /opt/duckstore/web/app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
